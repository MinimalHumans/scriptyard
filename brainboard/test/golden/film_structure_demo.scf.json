    "character": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000002",
        "values": {
          "name": "Owen Jenkins",
          "role": "protagonist",
          "age": "Mid 30's",
          "pronouns": "he/him",
          "occupation": "Moon Base Commmander",
          "summary": "A mostly even tempered dude, in love with Nancy secretly.",
          "external_id": "sOU_bd6DIh4gvjQY_tKAS",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 2,
        "uuid": "00000000-0000-4000-8000-000000000003",
        "values": {
          "name": "Jerry Perkins",
          "role": "antagonist",
          "age": "Mid 30's",
          "pronouns": "he/him",
          "occupation": "Moon Base Maintenance",
          "summary": "A truly irritating person. Can't read a room and always makes the wrong choice.",
          "external_id": "OL5Vaz9ZJ1sdIQZPZXF1K",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 3,
        "uuid": "00000000-0000-4000-8000-000000000004",
        "values": {
          "name": "Nancy Flerkins",
          "role": "protagonist",
          "age": "Mid 40's",
          "pronouns": "she/her",
          "occupation": "Moon Base Science Officer",
          "summary": "A competent and strong person. Knows that Owen has feelings for her but doesn't reciprocate them.",
          "external_id": "Z-E1b0roLHEi1h-GYlCXx",
          "external_id_namespace": "scriptyard"
        }
      }
    ],
    "location": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000005",
        "values": {
          "name": "Moon Base",
          "location_type": "int/ext",
          "setting": "It's a functional building in a desolate place. It's a little dated feeling even in the future.",
          "time_period": "2245",
          "external_id": "vW_5Te5O7KXZY_ItGbLOB",
          "external_id_namespace": "scriptyard"
        }
      }
    ],
    "location_design": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000006",
        "values": {
          "location_id": 1,
          "emotional_target": "Desolate"
        }
      }
    ],
    "act": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000007",
        "values": {
          "name": "The Setup",
          "act_number": 1,
          "function": "Meeting the crew and getting a sense of the location on the Moon Base.",
          "dramatic_question": "How will they handle the desolation and lonliness they face?",
          "shift": "Alliances form and Jerry's left out to dry.",
          "external_id": "vV4zknMSLvZ6G2ZtZZdFb",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 1
        }
      },
      {
        "id": 2,
        "uuid": "00000000-0000-4000-8000-000000000037",
        "values": {
          "name": "The Confrontation",
          "act_number": 2,
          "function": "Jerry has had enough of being slapped.",
          "dramatic_question": "What will he do about it?",
          "shift": "Jerry takes control of a situation that he was previously powerless in.",
          "external_id": "qRgQmQLwqjMb-Oi5BAh1E",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 7
        }
      },
      {
        "id": 3,
        "uuid": "00000000-0000-4000-8000-000000000061",
        "values": {
          "name": "Act Three : Resolution",
          "act_number": 3,
          "external_id": "-y5loNXU6XTv7Q1LaUBYV",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 11
        }
      }
    ],
    "sequence": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000010",
        "values": {
          "name": "Welcome to the Moon Base",
          "sequence_number": 1,
          "goal": "Setting up the Moon Base Location and the characters living there.",
          "external_id": "LCLDeSPKnPWbIymEnfikI",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 1
        }
      },
      {
        "id": 2,
        "uuid": "00000000-0000-4000-8000-000000000019",
        "values": {
          "name": "What's wrong on the Moon Base?",
          "sequence_number": 2,
          "goal": "We've established the Moon Base, but what's the situation?",
          "conflict": "Not much to do here.",
          "outcome": "The crew is bored and a bit lonely.",
          "external_id": "ft9SRGLNPyXOBJ1wC10d-",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 3
        }
      },
      {
        "id": 3,
        "uuid": "00000000-0000-4000-8000-000000000025",
        "values": {
          "name": "The Performance",
          "sequence_number": 3,
          "goal": "The three crew members need to perform a play for themselves in order to pass the time.",
          "conflict": "It's hard and in the stress of the moment tempers flare as well as some unspoken passions.",
          "outcome": "One of them is wounded.",
          "external_id": "r2B0Nw_KcDUc9kz1sZRAS",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 4
        }
      },
      {
        "id": 4,
        "uuid": "00000000-0000-4000-8000-000000000040",
        "values": {
          "name": "Jerry Fights Back",
          "sequence_number": 4,
          "goal": "Jerry is tired of being bullied and wants it to stop.",
          "conflict": "Owen and Nancy react to Jerry for a reason, he's kind of a jerk.",
          "outcome": "Jerry makes everything worse.",
          "external_id": "dGvLjsUrfEyxzZFzaNQcx",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 7
        }
      },
      {
        "id": 5,
        "uuid": "00000000-0000-4000-8000-000000000049",
        "values": {
          "name": "Intervention with Jerry",
          "sequence_number": 5,
          "goal": "Owen and Nancy need their space from Jerry and they want to let him know diplomatically.",
          "conflict": "Jerry's not having it.",
          "outcome": "Rather than a solution, things are even worse. Jerry feels like the victim, which he is, but he's also just so damn hard to deal with.",
          "external_id": "a9v-xuElPg9w6E0Xe3l1f",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 9
        }
      },
      {
        "id": 6,
        "uuid": "00000000-0000-4000-8000-000000000055",
        "values": {
          "name": "The Lasagna",
          "sequence_number": 6,
          "goal": "Jerry puts laxative in the Lasagna, including his own.",
          "conflict": "Laxative is a bad tool for conflict resolution.",
          "outcome": "Every toilet is occupied by a pissed off individual.",
          "external_id": "v2Tx3G4o-QqcTzjvxW8vF",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 10
        }
      },
      {
        "id": 7,
        "uuid": "00000000-0000-4000-8000-000000000064",
        "values": {
          "name": "The Confession",
          "sequence_number": 7,
          "goal": "Owen and Nancy want to know what happened, Jerry wants them to know he did it and why.",
          "conflict": "Jerry thinks this will fix thing.",
          "outcome": "It doesn't.",
          "external_id": "3fn5XswD1nBueB1Mm1yP9",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 11
        }
      },
      {
        "id": 8,
        "uuid": "00000000-0000-4000-8000-000000000073",
        "values": {
          "name": "The Quarantine",
          "sequence_number": 8,
          "goal": "Get Jerry to agree to terms of avoidance. That he stays away from Owen and Nancy.",
          "conflict": "Jerry is difficult.",
          "outcome": "Jerry reluctantly agrees. But it doesn't end well.",
          "external_id": "H29kigcL9x0WaPKygmNBJ",
          "external_id_namespace": "scriptyard",
          "start_scene_id": 13
        }
      }
    ],
    "scene": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000013",
        "values": {
          "name": "EXT.  MOON BASE - DAY",
          "scene_number": "1",
          "int_ext": "exterior",
          "time_of_day": "day",
          "goal": "Show the setting of the story.",
          "outcome": "We see that we are on a desolate moon base.",
          "external_id": "DoTGEfDG6_LDyzBQpcIQS",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 2,
        "uuid": "00000000-0000-4000-8000-000000000016",
        "values": {
          "name": "INT. MOON BASE - DAY",
          "scene_number": "2",
          "int_ext": "interior",
          "time_of_day": "day",
          "goal": "Here we meet the three occupants of the Moon Base.",
          "conflict": "We meet the small crew and try to work out what the situation is.",
          "outcome": "We see that they are pretty bored.",
          "external_id": "cDie09w9GM93zdb4YF682",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 3,
        "uuid": "00000000-0000-4000-8000-000000000022",
        "values": {
          "name": "INT. MOON BASE  - DAY",
          "scene_number": "3",
          "int_ext": "interior",
          "time_of_day": "day",
          "goal": "Find out why they are so bored.",
          "conflict": "The communication with Earth has been down for 5 days and they're getting behind on their favorite Soap Opera.",
          "outcome": "They are constructing costumes to enact their own version of the story.",
          "external_id": "IaLSYjF6GI0fR79CN92ce",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 4,
        "uuid": "00000000-0000-4000-8000-000000000028",
        "values": {
          "name": "INT. MOON BASE - AUDITORIUM - NIGHT",
          "scene_number": "4",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Three crew mates must find a way to perform their interpretation of their favorite soap opera, two at a time for the third to watch,",
          "conflict": "This is logistically difficult.",
          "outcome": "They do a poor job of it.",
          "external_id": "RGyY2dEdR-5ntzP_66YHp",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 5,
        "uuid": "00000000-0000-4000-8000-000000000031",
        "values": {
          "name": "INT. MOON BASE - BACKSTAGE - NIGHT",
          "scene_number": "5",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Introduce the tension.",
          "conflict": "Jerry didn't like Nancy's interpretation of the Soap Opera character \"Debbie\", he felt it lakced \"gravitas\"",
          "outcome": "Nancy slapped the shit out of Jerry.",
          "external_id": "dhhhpCxj9EVFcCUGM8co5",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 6,
        "uuid": "00000000-0000-4000-8000-000000000034",
        "values": {
          "name": "INT. MOON BASE - INFIRMARY - NIGHT",
          "scene_number": "6",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Owen interrogates Jerry on what went down between him and Nancy.",
          "conflict": "Owen is in love with Nancy and is very protective of her.",
          "outcome": "Jerry trash talks Nancy and Owen slaps the shot out of Jerry (for a second time).",
          "external_id": "9IinkaLKLcdO1MaGEtUIk",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 7,
        "uuid": "00000000-0000-4000-8000-000000000043",
        "values": {
          "name": "INT. MOON BASE - CAFETERIA - MORNING",
          "scene_number": "7",
          "int_ext": "interior",
          "time_of_day": "morning",
          "goal": "Jerry needs to air his grievances with Owen and Nancy.",
          "conflict": "Jerry is tired of being the punching bag due to his spciy opinions.",
          "outcome": "Owen and Nancy have had just about enough of Jerry's nonsense.",
          "external_id": "vuAKX-MiTjfAFJ5wtvn7b",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 8,
        "uuid": "00000000-0000-4000-8000-000000000046",
        "values": {
          "name": "INT. MOON BASE - COMMAND CHAMBER - DAY",
          "scene_number": "8",
          "int_ext": "interior",
          "time_of_day": "day",
          "goal": "Owen and Nancy need to deal with the issues with Jerry.",
          "conflict": "Jerry is a jerk and is tired of being bullied.",
          "outcome": "Jerry's approach at communication fails and Owen and Nancy decide to present a solution, to spend some time away from Jerry.",
          "external_id": "5ZYbO1H1HQkmkuDoGt5Wa",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 9,
        "uuid": "00000000-0000-4000-8000-000000000052",
        "values": {
          "name": "INT. MOON BASE - KITCHEN - NIGHT",
          "scene_number": "9",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Jerry's misguided sense of justice allows him to feel that putting laxative in the Lasagna is a good way to resolve the conflict.",
          "conflict": "Jerry's ideas are nearly always making things worse.",
          "outcome": "Things get worse. Like, a lot worse.",
          "external_id": "KrFHyWh2B1NEW7mgWII45",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 10,
        "uuid": "00000000-0000-4000-8000-000000000058",
        "values": {
          "name": "INT. MOON BASE - CAFETERIA - NIGHT",
          "scene_number": "10",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Jerry serves Laxative laced Lasagna to the crew, including himself.",
          "conflict": "Laxatives make you poo",
          "outcome": "Everyone is running for the toilets, not know why.",
          "external_id": "n2ZfdMv694q88-IgfjDHN",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 11,
        "uuid": "00000000-0000-4000-8000-000000000067",
        "values": {
          "name": "INT. MOON BASE - ARCADE - MORNING",
          "scene_number": "11",
          "int_ext": "interior",
          "time_of_day": "morning",
          "goal": "Jerry invites Owen and Nancy to the arcade in the Moon Base to explain what he did.",
          "conflict": "Jerry thinks this will help things, but Jerry is an idiot.",
          "outcome": "Owen and Nancy are stunned by the idiocy of Jerry. The loud atmosphere helped nothing.",
          "external_id": "rZjnzaT3q6Z9AQ9w_p-UE",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 12,
        "uuid": "00000000-0000-4000-8000-000000000070",
        "values": {
          "name": "INT. MOON BASE - COMMAND CHAMBER - DAY",
          "scene_number": "12",
          "int_ext": "interior",
          "time_of_day": "day",
          "goal": "Owen and Nancy decide they have had enough of Jerry. It's not longer tolerable, he needs to be dealt with.",
          "conflict": "How to get rid of Jerry?",
          "outcome": "They decide that the terms of their stay make it impossible to send him home, they will need to make a barrier and lock him in one part of the base until the contract is up and they go back to Earth.",
          "external_id": "4Nnz5nRbJ8Dr7E3GiigYB",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 13,
        "uuid": "00000000-0000-4000-8000-000000000076",
        "values": {
          "name": "INT. MOON BASE - CAFETERIA - NIGHT",
          "scene_number": "13",
          "int_ext": "interior",
          "time_of_day": "night",
          "goal": "Owen and Nancy break the news to Jerry.",
          "conflict": "Jerry takes everything badly. How did he get this job in the first place? Aren't there psych evals for Moon Base operators?",
          "outcome": "Jerry reluctantly agrees. But in a petty passive agressive move, he steals all the toilet paper and keeps it on his section of the base.",
          "external_id": "TapO4cwqOJLIqzcrukZ61",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 14,
        "uuid": "00000000-0000-4000-8000-000000000079",
        "values": {
          "name": "INT. MOON BASE - MAIN AIRLOCK - DAWN",
          "scene_number": "14",
          "int_ext": "interior",
          "time_of_day": "dawn",
          "goal": "Owen and Nancy need to deal with Jerry once and for all.",
          "conflict": "Jerry is resistant to any good solution.",
          "outcome": "The ask Jerry to do some maintenance in the air lock, then they open the doors. Bye bye Jerry.",
          "external_id": "X54Cb_KkWpINVNmhclnUO",
          "external_id_namespace": "scriptyard"
        }
      }
    ]
  },
