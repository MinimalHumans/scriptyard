      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000045",
      "lineType": "action",
      "content": "Having survived the ordeal, the hero gains something of value—an object, knowledge, power, or insight. This reward represents progress but does not yet resolve the story.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000046",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
