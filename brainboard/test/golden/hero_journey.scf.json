      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000060",
      "lineType": "action",
      "content": "The hero returns home transformed, bringing something back that benefits others (knowledge, healing, power, etc.). This resolves both the external conflict and the internal arc.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    }
