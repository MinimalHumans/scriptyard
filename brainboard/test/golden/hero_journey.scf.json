      "lineType": "action",
      "content": "BEAT: 10. The Road Back",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000048",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000049",
      "lineType": "action",
      "content": "The hero begins the journey back to the ordinary world, but consequences arise. The stakes are often raised again, and the hero may be pursued or tested further.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000050",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
