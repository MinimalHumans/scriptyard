      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000056",
      "lineType": "action",
      "content": "A final, climactic test forces the hero to apply everything they’ve learned. This is a moment of rebirth where the hero proves they’ve truly changed.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000057",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000058",
      "lineType": "action",
      "content": "BEAT: 12. Return with the Elixir",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
