    "act": [
      {
        "id": 1,
        "uuid": "00000000-0000-4000-8000-000000000002",
        "values": {
          "name": "Act One (Departure)",
          "act_number": 1,
          "summary": "This act establishes the hero and pushes them out of their comfort zone. It ends when they fully commit and enter the new world.",
          "external_id": "kxOJpNyk0-QF3fD-JeipS",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 2,
        "uuid": "00000000-0000-4000-8000-000000000025",
        "values": {
          "name": "Act Two – Part A (Initiation: Learning the Rules)",
          "act_number": 2,
          "summary": "The hero is tested and shaped by the new world, culminating in a major confrontation that begins their transformation.",
          "external_id": "qmmZ5WsyMBiMN84YfPEJD",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 3,
        "uuid": "00000000-0000-4000-8000-000000000040",
        "values": {
          "name": "Act Two – Part B (Initiation: Consequences and Growth)",
          "act_number": 3,
          "summary": "After the ordeal, the hero gains something but must deal with its consequences. The journey shifts toward resolution.",
          "external_id": "xzf5AGsrNvyhMtxs__r4d",
          "external_id_namespace": "scriptyard"
        }
      },
      {
        "id": 4,
        "uuid": "00000000-0000-4000-8000-000000000051",
        "values": {
          "name": "Act Three (Return)",
          "act_number": 4,
          "summary": "The hero faces a final test and returns home changed, completing their arc and resolving the story.",
          "external_id": "rH5pI5khstjik-xXUXPdB",
          "external_id_namespace": "scriptyard"
        }
      }
    ]
  },
