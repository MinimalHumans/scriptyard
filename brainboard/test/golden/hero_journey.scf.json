    },
    {
      "uuid": "00000000-0000-4000-8000-000000000030",
      "lineType": "action",
      "content": "The hero faces challenges, makes friends, and encounters adversaries. Through these trials, they begin to understand the rules of the new world. This stage builds skills, relationships, and tension.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000031",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000032",
      "lineType": "action",
      "content": "BEAT: 7. Approach to the Inmost Cave",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000033",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000034",
      "lineType": "action",
      "content": "The hero prepares for a major challenge, often venturing into a dangerous or symbolic location. This is a moment of planning, tension, and introspection before the central ordeal.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000035",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000036",
      "lineType": "action",
      "content": "BEAT: 8. The Ordeal",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000037",
      "lineType": "blank",
      "content": "",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000038",
      "lineType": "action",
      "content": "The hero faces a major crisis—often a life-or-death moment or their greatest fear. This is the emotional and narrative core of the story where transformation begins.",
      "sceneId": null,
      "locationId": null,
      "metadata": null
    },
    {
      "uuid": "00000000-0000-4000-8000-000000000039",
      "lineType": "blank",
      "content": "",
